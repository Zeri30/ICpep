# Local-development defaults below. In production: APP_ENV=production,
# APP_DEBUG=false (a stack trace in a JSON error response is a real
# information leak — config('app.debug') defaults to false on its own if this
# is left unset entirely, but don't rely on that; set it explicitly) and
# APP_URL/FRONTEND_URL pointed at the real domains.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug is fine locally; production should log warning or error so routine
# traffic doesn't fill the log with debug-level noise.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Left unset, Laravel marks the session/remember-me cookies Secure based on
# whether it thinks the current request is HTTPS (config/session.php,
# RememberMeService) — which only works if TRUSTED_PROXIES below is set
# correctly when running behind a reverse proxy. Set this to true explicitly
# in production rather than relying on that detection.
# SESSION_SECURE_COOKIE=true

# The reverse proxy/load balancer in front of this app, if any (nearly every
# PaaS puts one there) — see bootstrap/app.php. Comma-separated IPs, or "*" to
# trust whatever forwards the request, which is safe exactly when the
# platform's own network is the only way to reach this app. Left empty (the
# default), every request's peer address is trusted as-is: correct only when
# PHP is reachable directly with nothing in front of it.
TRUSTED_PROXIES=

# --- Remember me ----------------------------------------------------------
REMEMBER_ME_COOKIE=icpep_remember
REMEMBER_ME_DURATION_DAYS=30

# Minutes of no genuine admin activity before a session is forced out.
ADMIN_IDLE_TIMEOUT_MINUTES=360

# Days an Activity Log row is kept before the daily scheduled prune deletes it.
ACTIVITY_LOG_RETENTION_DAYS=730

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
